---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { withBase } from '../lib/url';

const gallery = [
  { src: '/images/referenzen/porsche-tunnel.jpg', alt: 'Porsche 911 Turbo mit Chamäleon-Folierung in einer Tunneldurchfahrt', caption: 'Porsche 911 Turbo · Folierung' },
  { src: '/images/referenzen/porsche-esso.jpg', alt: 'Porsche 911 Turbo mit orangener Vollfolierung an einer Tankstelle', caption: 'Porsche 911 Turbo · Vollfolierung' },
  { src: '/images/referenzen/vw-touareg.jpg', alt: 'VW Touareg mit Wimmer-Fahrzeugbeschriftung im Wald', caption: 'VW Touareg · Fahrzeugbeschriftung' },
  { src: '/images/referenzen/golf-drift.jpg', alt: 'Kompaktsportwagen mit Wimmer-Rennlackierung im Drift', caption: 'Rennfahrzeug · Vollfolierung' },
];
---

<BaseLayout
  title="Referenzen"
  description="Referenzfahrzeuge und Projekte von Wimmer Rennsporttechnik: Auspuffanlagen, Fahrwerksumbauten und mehr."
  path="/referenzen"
>
  <section class="border-b border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
    <div class="container-page py-16 sm:py-20">
      <p class="eyebrow">Referenzen</p>
      <h1 class="mt-3 max-w-3xl text-balance text-4xl font-black tracking-tight sm:text-5xl">
        Projekte aus unserer Werkstatt
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/60">
        Eine gebündelte Übersicht statt verstreuter Einzelseiten pro Marke und Modell –
        hier sammeln wir Fotos realisierter Projekte an einem zentralen Ort. Weitere folgen.
      </p>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((item) => (
        <div class="overflow-hidden rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
          <img
            src={withBase(item.src)}
            alt={item.alt}
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <div class="p-4">
            <p class="font-semibold text-white">{item.caption}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTA title="Ihr Fahrzeug als nächstes Projekt?" lead="Erzählen Sie uns, was Sie vorhaben." />
</BaseLayout>
