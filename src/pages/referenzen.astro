---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

const gallery = [
  { brand: 'BMW', category: 'Auspuffanlage' },
  { brand: 'Audi', category: 'Auspuffanlage' },
  { brand: 'Mazda MX-5', category: 'Auspuffanlage' },
  { brand: 'Ford', category: 'Umbau' },
  { brand: 'KTM X-Bow', category: 'Fahrzeug' },
  { brand: 'Diverse Modelle', category: 'Fahrwerkstechnik' },
];
---

<BaseLayout
  title="Referenzen"
  description="Referenzfahrzeuge und Projekte von Wimmer Rennsporttechnik: Auspuffanlagen, Fahrwerksumbauten und mehr."
  path="/referenzen"
>
  <section class="border-b border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
    <div class="container-page py-16 sm:py-20">
      <p class="eyebrow">Referenzen</p>
      <h1 class="mt-3 max-w-3xl text-balance text-4xl font-black tracking-tight sm:text-5xl">
        Projekte aus unserer Werkstatt
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/60">
        Eine gebündelte Übersicht statt verstreuter Einzelseiten pro Marke und Modell –
        hier sammeln wir künftig Fotos realisierter Projekte an einem zentralen Ort.
      </p>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="mb-8 rounded-2xl border border-dashed border-[color:var(--color-line)] bg-[color:var(--color-surface)] p-5 text-sm text-white/55">
      Platzhalter-Struktur: Diese Kacheln zeigen, wie echte Projektfotos später einsortiert
      werden. Bilder aus der bisherigen Galerie konnten technisch nicht automatisch übernommen
      werden und sollten hier final ergänzt werden.
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((item) => (
        <div class="overflow-hidden rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
          <div class="flex aspect-[4/3] items-center justify-center bg-[linear-gradient(135deg,var(--color-surface-2),var(--color-ink))] text-white/25">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" stroke="currentColor" stroke-width="1.5" />
              <circle cx="8" cy="10" r="2" stroke="currentColor" stroke-width="1.5" />
              <path d="M2 17l5-5 4 4 4-3 7 6" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </div>
          <div class="p-4">
            <p class="font-semibold text-white">{item.brand}</p>
            <p class="text-sm text-white/50">{item.category}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <CTA title="Ihr Fahrzeug als nächstes Projekt?" lead="Erzählen Sie uns, was Sie vorhaben." />
</BaseLayout>
