---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import { withBase } from '../lib/url';
import { referenzenGallery as gallery } from '../data/site';
---

<BaseLayout
  title="Referenzen"
  description="Referenzfahrzeuge und Projekte von Wimmer Rennsporttechnik: Auspuffanlagen, Fahrwerksumbauten und mehr."
  path="/referenzen"
>
  <section class="border-b border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
    <div class="container-page py-16 sm:py-20">
      <p class="eyebrow">Referenzen</p>
      <h1 class="mt-3 max-w-3xl text-balance text-4xl font-black tracking-tight sm:text-5xl">
        Projekte aus unserer Werkstatt
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/60">
        Eine gebündelte Übersicht statt verstreuter Einzelseiten pro Marke und Modell –
        hier sammeln wir Fotos realisierter Projekte an einem zentralen Ort. Weitere folgen.
      </p>
    </div>
  </section>

  <section class="container-page py-16 sm:py-20">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((item) => (
        <div class="overflow-hidden rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
          <img
            src={withBase(item.src)}
            alt={item.alt}
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
          <div class="p-4">
            <p class="font-semibold text-white">{item.caption}</p>
          </div>
        </div>
      ))}

      <a
        href="https://www.instagram.com/wimmer_rst/"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex aspect-[4/3] flex-col items-center justify-center gap-3 overflow-hidden rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)] transition-colors hover:border-[color:var(--color-accent)]"
      >
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-white/70 transition-colors group-hover:text-[color:var(--color-accent)]">
          <rect x="2" y="2" width="20" height="20" rx="6" stroke="currentColor" stroke-width="1.6" />
          <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.6" />
          <circle cx="17.4" cy="6.6" r="1.2" fill="currentColor" />
        </svg>
        <span class="font-semibold text-white">@wimmer_rst auf Instagram</span>
      </a>
    </div>
  </section>

  <CTA title="Ihr Fahrzeug als nächstes Projekt?" lead="Erzählen Sie uns, was Sie vorhaben." />
</BaseLayout>
