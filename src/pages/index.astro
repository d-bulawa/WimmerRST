---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import VehicleFinder from '../components/VehicleFinder.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Hero from '../components/Hero.astro';
import { stats, leistungenChildren, brands, company, referenzenGallery } from '../data/site';
import { withBase } from '../lib/url';

const partnerBrands = brands.slice(0, 6);
const heroGallery = referenzenGallery.filter((img) => img.hero);

const companyInfo = [
  {
    title: 'Unser Prüfstand',
    text: 'Mit unseren hauseigenen Hochleistungsprüfständen von Dynojet und Bosch messen wir Leistung bis zu 2.000 PS. Die Prüfstände sind von führenden Fahrzeugherstellern und dem TÜV zugelassen – jede Optimierung wird bei uns direkt vor Ort validiert.',
    icon: '/images/brand/icon_gauge.png',
  },
  {
    title: 'TÜV-zertifizierter Fachbetrieb',
    text: 'Verbaute Komponenten sind in der Regel straßenzulassungsfähig und werden bei Bedarf direkt an unserer angeschlossenen TÜV-Prüfstelle im Haus abgenommen.',
    icon: '/images/brand/logo_brand_tuev.png',
  },
  {
    title: 'KW Performance Partner Pro',
    text: company.kwPartnership,
    icon: '/images/brand/logo_brand_kw_partner.png',
    iconWide: true,
  },
  {
    title: 'Garantie',
    text: company.warranty,
    id: 'garantie',
    icon: '/images/brand/icon_guarantee.png',
  },
];
---

<BaseLayout
  title="Chiptuning, Auspuffanlagen & Fahrwerkstechnik"
  description="Wimmer Rennsporttechnik Solingen: TÜV-zertifizierter Fachbetrieb für Chiptuning, Edelstahl-Auspuffanlagen und Fahrwerkstechnik – seit 1990."
  path="/"
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_20%,rgba(227,6,19,0.20),transparent_60%),radial-gradient(circle_at_85%_0%,rgba(255,90,104,0.12),transparent_55%)]"></div>
    <Hero gallery={heroGallery}>
      <Fragment slot="eyebrow">Wimmer Rennsporttechnik · Solingen · seit {company.founded}</Fragment>
      <Fragment slot="headline">Mehr Leistung.<br />Präzise umgesetzt.</Fragment>
      <Fragment slot="text">
        Chiptuning, handgefertigte Edelstahl-Auspuffanlagen und Fahrwerkstechnik von einem
        TÜV-zertifizierten Fachbetrieb – auf 2.400&nbsp;m² Werkstattfläche, mit eigenem
        Hochleistungsprüfstand.
      </Fragment>
      <Fragment slot="actions">
        <a href={withBase('/leistungen')} class="btn-primary">Leistungen entdecken</a>
        <a href={withBase('/kontakt')} class="btn-secondary">Termin anfragen</a>
      </Fragment>
      <Fragment slot="finder">
        <VehicleFinder compact />
      </Fragment>
    </Hero>
  </section>

  <section class="border-y border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
    <div class="container-page grid grid-cols-2 gap-6 py-10 sm:grid-cols-4">
      {stats.map((stat) => (
        <div>
          <p class="text-3xl font-black tracking-tight text-[color:var(--color-accent)] sm:text-4xl">{stat.value}</p>
          <p class="mt-1 text-sm text-white/55">{stat.label}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="unternehmen" class="container-page py-16 sm:py-20">
    <div class="grid gap-8 lg:grid-cols-[0.4fr_0.6fr]">
      <div>
        <p class="eyebrow">Seit {company.founded}</p>
        <h2 class="mt-3 text-balance text-2xl font-black tracking-tight sm:text-3xl">Vom Tankstellen-Umbau zur 2.400 m² Werkstatt</h2>
      </div>
      <div>
        <p class="text-white/60 leading-relaxed">{company.history}</p>
        <img
          src={withBase('/images/brand/Wimmer_Gasstation.jpg')}
          alt="Historische AVIA-Tankstelle, Ursprung von Wimmer Rennsporttechnik"
          class="mt-6 aspect-[2/1] w-full rounded-2xl border border-[color:var(--color-line)] object-cover grayscale"
        />
      </div>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {companyInfo.map((info) => (
        <div class="card" id={info.id}>
          <div class:list={['mx-auto mb-5 flex h-20 items-center justify-center', info.iconWide ? 'w-full max-w-[200px]' : 'w-20']}>
            <img src={withBase(info.icon)} alt="" class="h-full w-full object-contain" />
          </div>
          <h3 class="text-lg font-bold text-white">{info.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/55">{info.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page py-20 sm:py-24">
    <div class="grid gap-8 lg:grid-cols-[0.4fr_0.6fr]">
      <div>
        <p class="eyebrow">Leistungen</p>
        <h2 class="mt-3 text-balance text-3xl font-black tracking-tight sm:text-4xl">Alles aus einer Hand</h2>
        <a href={withBase('/leistungen')} class="mt-4 inline-block text-sm font-semibold text-white/70 hover:text-white">Alle Leistungen ansehen →</a>
      </div>
      <div>
        <p class="text-white/60 leading-relaxed">
          Von der Software bis zum Fahrwerk: Wir stimmen jede Maßnahme an Ihrem Fahrzeug
          aufeinander ab, damit Leistung, Fahrverhalten und Zuverlässigkeit zusammenpassen –
          alles aus einer Hand.
        </p>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {leistungenChildren.map((item) => (
            <a href={withBase(item.href)} class="card group hover:border-[color:var(--color-accent)]">
              {item.icon && (
                <div class="mx-auto mb-4 flex h-20 w-20 items-center justify-center">
                  <img src={withBase(item.icon)} alt="" class="h-full w-full object-contain" />
                </div>
              )}
              <h3 class="text-lg font-bold text-white">{item.label}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/55">{item.blurb}</p>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-[color:var(--color-accent)] opacity-0 transition-opacity group-hover:opacity-100">
                Mehr erfahren →
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="container-page mt-36 sm:mt-44">
      <div class="grid gap-8 lg:grid-cols-[0.4fr_0.6fr]">
        <div>
          <p class="eyebrow">Marken & Partner</p>
          <h2 class="mt-3 text-balance text-2xl font-black tracking-tight sm:text-3xl">
            Marken, denen der Markt vertraut
          </h2>
          <a href={withBase('/marken')} class="mt-4 inline-block text-sm font-semibold text-white/70 hover:text-white">Alle Marken & Partner →</a>
        </div>
        <div>
          <p class="text-white/60 leading-relaxed">
            Statt Dutzender einzelner Markenseiten finden Sie hier alle Partner gebündelt an
            einem Ort – von Fahrwerkstechnik über Bremsanlagen bis zu Sportkupplungen.
          </p>
          <div class="mt-8 grid grid-cols-3 gap-4">
            {partnerBrands.map((brand) => (
              <a
                href={brand.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-28 items-center justify-center rounded-xl border border-[color:var(--color-line)] bg-[color:var(--color-ink)] px-4 hover:border-[color:var(--color-accent)]"
              >
                <BrandLogo name={brand.name} logo={brand.logo} size={72} />
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>
