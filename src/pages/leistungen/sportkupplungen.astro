---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FeatureTabs from '../../components/FeatureTabs.astro';
import CTA from '../../components/CTA.astro';

const features = [
  {
    title: 'Bessere Kraftübertragung',
    text: 'Eine Sportkupplung setzt die zusätzliche Leistung aus dem Chiptuning verlustfrei in Vortrieb um.',
  },
  {
    title: 'ZF Sachs Race Engineering',
    text: 'Kupplungstechnik aus dem Motorsport für hohe Belastbarkeit.',
  },
  {
    title: 'LUK',
    text: 'Bewährte Kupplungssysteme als solide Ergänzung zur Leistungssteigerung.',
  },
];
---

<BaseLayout
  title="Sportkupplungen"
  description="Sportkupplungen von ZF Sachs Race Engineering und LUK für bessere Kraftübertragung nach dem Chiptuning."
  path="/leistungen/sportkupplungen"
>
  <PageHeader
    eyebrow="Leistungen · Sportkupplungen"
    title="Kraftübertragung, die mithält"
    icon="/images/products/icon_prod_clutch.png"
    lead="Mehr Drehmoment braucht eine Kupplung, die es sauber überträgt. Wir verbauen Sportkupplungen von ZF Sachs Race Engineering und LUK, abgestimmt auf Ihre Leistungsstufe."
  />

  <section class="container-page py-16 sm:py-20">
    <FeatureTabs features={features} />
  </section>

  <CTA title="Passt Ihre Kupplung noch zur Leistung?" lead="Wir prüfen, ob ein Upgrade sinnvoll ist, bevor die Serienkupplung an ihre Grenzen kommt." />
</BaseLayout>
