---
import { company, leistungenChildren } from '../data/site';
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
  <div class="container-page grid gap-10 py-14 lg:grid-cols-4">
    <div>
      <a href={withBase('/')} class="flex items-center">
        <img
          src={withBase('/images/brand/wimmer-logo.png')}
          alt="Wimmer Rennsporttechnik Solingen"
          class="h-12 w-auto"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/55">
        Seit {company.founded} Ihr TÜV-zertifizierter Partner für Chiptuning, Auspuffanlagenbau
        und Fahrwerkstechnik in Solingen.
      </p>
      <a
        href="https://www.instagram.com/wimmer_rst/"
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 text-sm text-white/55 hover:text-white"
      >
        Instagram @wimmer_rst
      </a>
    </div>

    <div>
      <h3 class="eyebrow">Leistungen</h3>
      <ul class="mt-4 space-y-2 text-sm">
        {leistungenChildren.map((item) => (
          <li><a href={withBase(item.href)} class="text-white/65 hover:text-white">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="eyebrow">Unternehmen</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={withBase('/fahrzeugsuche')} class="text-white/65 hover:text-white">Fahrzeugsuche</a></li>
        <li><a href={withBase('/marken')} class="text-white/65 hover:text-white">Marken & Partner</a></li>
        <li><a href={withBase('/referenzen')} class="text-white/65 hover:text-white">Referenzen</a></li>
        <li><a href={withBase('/unternehmen')} class="text-white/65 hover:text-white">Über uns</a></li>
        <li><a href={withBase('/wohnmobil')} class="text-white/65 hover:text-white">Wohnmobilvermietung</a></li>
        <li><a href={withBase('/kontakt')} class="text-white/65 hover:text-white">Kontakt & Anfahrt</a></li>
      </ul>
    </div>

    <div>
      <h3 class="eyebrow">Kontakt</h3>
      <address class="mt-4 space-y-1 text-sm not-italic text-white/65">
        <p>{company.address.street}</p>
        <p>{company.address.zip} {company.address.city}</p>
        <p class="pt-2">
          <a href={`tel:${company.phone.replace(/\s+/g, '')}`} class="hover:text-white">{company.phoneDisplay}</a>
        </p>
        <p><a href={`mailto:${company.email}`} class="hover:text-white">{company.email}</a></p>
      </address>
    </div>
  </div>

  <div class="border-t border-[color:var(--color-line)]">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-6 text-xs text-white/45 sm:flex-row">
      <p>&copy; {year} {company.name}</p>
      <div class="flex gap-5">
        <a href={withBase('/impressum')} class="hover:text-white">Impressum</a>
        <a href={withBase('/datenschutz')} class="hover:text-white">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
