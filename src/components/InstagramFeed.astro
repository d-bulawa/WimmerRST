---
// Echte Instagram-Beiträge von @wimmer_rst, eingebunden über Instagrams
// offizielle oEmbed-Einbettung (blockquote + embed.js). Das lädt Bild,
// Caption und Like-Zahl live von Instagram im Browser der Besucher:innen –
// erfordert keinen API-Key und funktioniert ohne eigenes Backend.
//
// Kein automatisch mitwachsender Feed: Die Liste der Permalinks unten ist
// fest im Code hinterlegt und muss von Hand ergänzt werden, wenn neue
// Beiträge dazukommen sollen. Für einen wirklich live nachziehenden Feed
// bräuchte es entweder die Instagram Graph API (Token + Backend zur
// Token-Erneuerung) oder einen Drittanbieter-Widget-Dienst, für den der
// Kunde sein Instagram-Konto selbst verbindet.
interface Props {
  permalinks: string[];
}
const { permalinks } = Astro.props;
---

<div class="grid gap-6" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
  {permalinks.map((url) => (
    <div class="flex justify-center overflow-hidden rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
      <blockquote
        class="instagram-media"
        data-instgrm-permalink={url}
        data-instgrm-version="14"
        style="width:100%; margin:0;"
      >
        <a href={url} target="_blank" rel="noopener noreferrer">Beitrag auf Instagram ansehen</a>
      </blockquote>
    </div>
  ))}
</div>

<script is:inline async src="https://www.instagram.com/embed.js"></script>
