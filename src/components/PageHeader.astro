---
import { withBase } from '../lib/url';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  icon?: string;
}
const { eyebrow, title, lead, icon } = Astro.props;
---

<section class="border-b border-[color:var(--color-line)] bg-[color:var(--color-surface)]">
  <div class:list={['container-page py-16 sm:py-20', icon && 'grid items-center gap-10 lg:grid-cols-[1fr_auto]']}>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-balance text-4xl font-black tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-white/60">{lead}</p>
    </div>
    {icon && (
      <img src={withBase(icon)} alt="" class="h-32 w-32 object-contain opacity-90 sm:h-40 sm:w-40 lg:h-48 lg:w-48" />
    )}
  </div>
</section>
