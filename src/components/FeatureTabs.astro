---
import { withBase } from '../lib/url';

interface Feature {
  title: string;
  text: string;
  image?: string;
}
interface Props {
  features: Feature[];
  /** Fällt für Features ohne eigenes Bild zurück (z. B. Seitenmotiv). */
  fallbackImage?: string;
}
const { features, fallbackImage } = Astro.props;
const firstImage = features[0].image ?? fallbackImage;
---

<div class="feature-tabs grid gap-4 lg:grid-cols-[minmax(0,340px)_1fr] lg:items-start lg:gap-6" data-feature-tabs>
  <div class="flex flex-col gap-3" role="tablist" aria-orientation="vertical" data-tablist>
    {features.map((f, i) => {
      const image = f.image ? withBase(f.image) : fallbackImage ? withBase(fallbackImage) : '';
      return (
        <div class="feature-tab-item">
          <button
            type="button"
            class="feature-tab-btn"
            role="tab"
            id={`feature-tab-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`feature-tab-panel-mobile-${i}`}
            tabindex={i === 0 ? '0' : '-1'}
            data-index={i}
            data-image={image}
            data-title={f.title}
            data-text={f.text}
          >
            <span>{f.title}</span>
            <svg class="feature-tab-btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M7.5 4.5L13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div
            class="feature-tab-panel feature-tab-panel-mobile"
            id={`feature-tab-panel-mobile-${i}`}
            role="tabpanel"
            aria-labelledby={`feature-tab-${i}`}
            data-panel-mobile
            hidden={i !== 0}
            style={image ? `background-image:url(${image})` : undefined}
          >
            <div class="feature-tab-glass">
              <h3 class="text-xl font-bold text-white sm:text-2xl">{f.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-white/80 sm:text-base">{f.text}</p>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <div
    class="feature-tab-panel feature-tab-panel-desktop"
    id="feature-tab-panel-desktop"
    role="tabpanel"
    aria-labelledby="feature-tab-0"
    data-panel
    style={firstImage ? `background-image:url(${withBase(firstImage)})` : undefined}
  >
    <div class="feature-tab-glass">
      <h3 data-panel-title class="text-xl font-bold text-white sm:text-2xl">{features[0].title}</h3>
      <p data-panel-text class="mt-3 text-sm leading-relaxed text-white/80 sm:text-base">{features[0].text}</p>
    </div>
  </div>
</div>

<style>
  .feature-tab-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-tab-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.75rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    padding: 1rem 1.25rem;
    text-align: left;
    font-weight: 700;
    color: #fff;
    border-left-width: 3px;
    transition: border-color 150ms, background-color 150ms, color 150ms;
  }
  .feature-tab-btn:hover {
    border-color: var(--color-accent);
  }
  .feature-tab-btn-arrow {
    height: 1.1rem;
    width: 1.1rem;
    flex: none;
    color: var(--color-line);
    transition: color 150ms, transform 150ms;
  }
  .feature-tab-btn[aria-selected='true'] {
    background-color: var(--color-surface-2);
    border-color: var(--color-accent);
    border-left-color: var(--color-accent);
  }
  .feature-tab-btn[aria-selected='true'] .feature-tab-btn-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  .feature-tab-panel {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background-color: var(--color-surface);
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: flex-end;
  }
  .feature-tab-panel[hidden] {
    display: none;
  }
  .feature-tab-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(11, 13, 16, 0.75) 0%, rgba(11, 13, 16, 0.15) 55%, transparent 100%);
  }
  .feature-tab-glass {
    position: relative;
    margin: 1.25rem;
    max-width: 30rem;
    border-radius: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background-color: rgba(11, 13, 16, 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    padding: 1.25rem 1.5rem;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
  }

  /*
    Unter 1024px reicht die Breite nicht mehr für Buttons + Panel
    nebeneinander (siehe lg:grid-cols oben). Deshalb bekommt dort jeder
    Button sein eigenes Panel direkt darunter (Akkordeon); das gemeinsame
    Panel rechts ist dann ausgeblendet – und umgekehrt ab 1024px.
  */
  .feature-tab-panel-mobile {
    min-height: 16rem;
  }
  .feature-tab-panel-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .feature-tab-panel-mobile {
      display: none;
    }
    .feature-tab-panel-desktop {
      display: flex;
      min-height: 30rem;
    }
  }
</style>

<script>
  function initFeatureTabs(root: Element) {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.feature-tab-btn'));
    const tablist = root.querySelector<HTMLElement>('[data-tablist]');
    const panel = root.querySelector<HTMLElement>('[data-panel]');
    const panelTitle = root.querySelector<HTMLElement>('[data-panel-title]');
    const panelText = root.querySelector<HTMLElement>('[data-panel-text]');
    const mobilePanels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel-mobile]'));
    if (!panel || !panelTitle || !panelText || !tablist) return;

    // Bindet die Panel-Höhe exakt an die Button-Liste, damit das Panel
    // unten bündig mit dem letzten Button abschließt (CSS-Grid-Stretch
    // allein reicht dafür je nach Schriftart-Rendering nicht zuverlässig).
    const isDesktop = window.matchMedia('(min-width: 1024px)');
    function syncPanelHeight() {
      if (isDesktop.matches) {
        panel!.style.minHeight = `${tablist!.getBoundingClientRect().height}px`;
      } else {
        panel!.style.minHeight = '';
      }
    }
    syncPanelHeight();
    new ResizeObserver(syncPanelHeight).observe(tablist);
    isDesktop.addEventListener('change', syncPanelHeight);

    function activate(index: number, focus = false) {
      const btn = buttons[index];
      if (!btn) return;
      buttons.forEach((b) => {
        b.setAttribute('aria-selected', 'false');
        b.tabIndex = -1;
      });
      btn.setAttribute('aria-selected', 'true');
      btn.tabIndex = 0;
      if (focus) btn.focus();

      const image = btn.dataset.image;
      panel!.style.backgroundImage = image ? `url(${image})` : 'none';
      panelTitle!.textContent = btn.dataset.title ?? '';
      panelText!.textContent = btn.dataset.text ?? '';
      panel!.setAttribute('aria-labelledby', btn.id);

      mobilePanels.forEach((p, i) => {
        p.hidden = i !== index;
      });
    }

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => activate(i));
      btn.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        let next: number | null = null;
        if (key === 'ArrowDown') next = (i + 1) % buttons.length;
        else if (key === 'ArrowUp') next = (i - 1 + buttons.length) % buttons.length;
        else if (key === 'Home') next = 0;
        else if (key === 'End') next = buttons.length - 1;
        if (next !== null) {
          event.preventDefault();
          activate(next, true);
        }
      });
    });
  }

  document.querySelectorAll('[data-feature-tabs]').forEach(initFeatureTabs);
</script>
