---
import { manufacturers } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const sortedManufacturers = [...manufacturers].sort((a, b) => a.name.localeCompare(b.name, 'de'));
---

<div class="vf" data-vehicle-finder>
  <div class="vf-box">
    <div class="vf-row">
      <div class="vf-combobox" data-combobox data-role="hersteller">
        <button type="button" class="vf-trigger" data-trigger aria-haspopup="listbox" aria-expanded="false">
          <span data-trigger-label>Hersteller</span>
          <svg class="vf-caret" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="vf-listbox" role="listbox" data-listbox tabindex="-1" hidden>
          <li role="option" data-value="" aria-selected="true">Hersteller</li>
          {sortedManufacturers.map((m) => (
            <li role="option" data-value={m.id}>{m.name}</li>
          ))}
        </ul>
      </div>

      <div class="vf-combobox" data-combobox data-role="modell">
        <button type="button" class="vf-trigger" data-trigger aria-haspopup="listbox" aria-expanded="false" aria-disabled="true" disabled>
          <span data-trigger-label>Modell</span>
          <svg class="vf-caret" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="vf-listbox" role="listbox" data-listbox tabindex="-1" hidden>
          <li role="option" data-value="" aria-selected="true">Modell</li>
        </ul>
      </div>

      <div class="vf-combobox" data-combobox data-role="fahrzeug">
        <button type="button" class="vf-trigger" data-trigger aria-haspopup="listbox" aria-expanded="false" aria-disabled="true" disabled>
          <span data-trigger-label>Fahrzeug</span>
          <svg class="vf-caret" viewBox="0 0 10 6" fill="none" aria-hidden="true">
            <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="vf-listbox" role="listbox" data-listbox tabindex="-1" hidden>
          <li role="option" data-value="" aria-selected="true">Fahrzeug</li>
        </ul>
      </div>

      <a data-fallback href={withBase('/kontakt')} class="btn-secondary vf-fallback justify-center whitespace-nowrap" style="display: none;">Fahrzeug per Kontakt anfragen</a>
    </div>
  </div>

  <p data-status class="vf-status" role="status"></p>
  {!compact && (
    <p class="vf-hint">
      Wählen Sie Hersteller, Modell und Fahrzeug, um passende Chiptuning- und Tuning-Optionen für Ihr Fahrzeug zu finden.
    </p>
  )}
</div>

<style>
  .vf-box {
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: color-mix(in srgb, var(--color-surface) 40%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .vf-box {
      padding: 1.5rem;
    }
  }

  .vf-row {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 640px) {
    .vf-row {
      grid-template-columns: 1fr 1fr 1fr auto;
      align-items: center;
    }
  }

  .vf-status {
    margin-top: 0.75rem;
    min-height: 1rem;
    font-size: 0.75rem;
    line-height: 1rem;
    color: rgba(255, 255, 255, 0.4);
  }
  .vf-hint {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.35);
  }

  .vf-combobox {
    position: relative;
  }

  .vf-trigger {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background-color: color-mix(in srgb, var(--color-ink) 70%, transparent);
    padding: 0.625rem 0.75rem;
    text-align: left;
    font-size: 0.875rem;
    color: #fff;
    transition: border-color 150ms, color 150ms;
  }
  .vf-trigger:hover:not(:disabled) {
    border-color: var(--color-accent);
  }
  .vf-trigger[aria-expanded='true'] {
    border-color: var(--color-accent);
  }
  .vf-trigger:disabled {
    color: rgba(255, 255, 255, 0.5);
    cursor: not-allowed;
  }

  .vf-caret {
    height: 6px;
    width: 10px;
    flex: none;
    color: rgba(255, 255, 255, 0.6);
    transition: transform 150ms;
  }
  .vf-trigger[aria-expanded='true'] .vf-caret {
    transform: rotate(180deg);
    color: var(--color-accent);
  }

  .vf-listbox {
    position: absolute;
    inset-inline: 0;
    top: calc(100% + 0.5rem);
    z-index: 30;
    max-height: 16rem;
    overflow-y: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background-color: var(--color-ink);
    padding: 0.375rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);

    scrollbar-width: thin;
    scrollbar-color: var(--color-accent) transparent;
  }
  .vf-listbox::-webkit-scrollbar {
    width: 8px;
  }
  .vf-listbox::-webkit-scrollbar-button {
    display: none;
    height: 0;
    width: 0;
  }
  .vf-listbox::-webkit-scrollbar-track {
    background: transparent;
  }
  .vf-listbox::-webkit-scrollbar-thumb {
    background-color: var(--color-accent);
    border-radius: 9999px;
  }

  .vf-listbox[hidden] {
    display: none;
  }

  .vf-listbox li {
    border-radius: 0.375rem;
    padding: 0.5rem 0.625rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    scroll-margin-block: 0.375rem;
  }
  .vf-listbox li.is-active {
    background-color: var(--color-accent);
    color: #fff;
  }
  .vf-listbox li[aria-selected='true'] {
    font-weight: 600;
    color: #fff;
  }

  .vf-fallback {
    display: none;
  }
</style>

<script>
  interface Option {
    value: string;
    label: string;
  }

  function parseOptionsHtml(html: string): Option[] {
    const template = document.createElement('template');
    template.innerHTML = html;
    return Array.from(template.content.querySelectorAll('option')).map((o) => ({
      value: o.value,
      label: o.textContent?.trim() ?? '',
    }));
  }

  function closeAllListboxes(except?: HTMLUListElement) {
    document.querySelectorAll<HTMLUListElement>('[data-listbox]').forEach((el) => {
      if (el !== except) el.hidden = true;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-trigger]').forEach((el) => {
      if (el !== except?.previousElementSibling) el.setAttribute('aria-expanded', 'false');
    });
  }

  function setupCombobox(box: HTMLElement) {
    const trigger = box.querySelector<HTMLButtonElement>('[data-trigger]')!;
    const label = trigger.querySelector<HTMLElement>('[data-trigger-label]')!;
    const listbox = box.querySelector<HTMLUListElement>('[data-listbox]')!;
    let onChange: ((value: string, label: string) => void) | null = null;

    const options = () => Array.from(listbox.querySelectorAll<HTMLLIElement>('[role="option"]'));

    function setActive(li: HTMLLIElement | null) {
      options().forEach((o) => o.classList.remove('is-active'));
      li?.classList.add('is-active');
    }

    function close() {
      listbox.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
    }

    function open() {
      if (trigger.disabled) return;
      closeAllListboxes(listbox);
      listbox.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      const current = options().find((o) => o.getAttribute('aria-selected') === 'true') ?? options()[0] ?? null;
      setActive(current);
      current?.scrollIntoView({ block: 'nearest' });
      listbox.focus();
    }

    function selectOption(li: HTMLLIElement) {
      options().forEach((o) => o.removeAttribute('aria-selected'));
      li.setAttribute('aria-selected', 'true');
      label.textContent = li.textContent ?? '';
      close();
      trigger.focus();
      onChange?.(li.dataset.value ?? '', li.textContent ?? '');
    }

    trigger.addEventListener('click', () => (listbox.hidden ? open() : close()));
    trigger.addEventListener('keydown', (event) => {
      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(event.key)) {
        event.preventDefault();
        open();
      }
    });

    listbox.addEventListener('keydown', (event) => {
      const opts = options();
      const activeIndex = opts.findIndex((o) => o.classList.contains('is-active'));
      const goTo = (i: number) => {
        const target = opts[Math.max(0, Math.min(opts.length - 1, i))];
        setActive(target);
        target?.scrollIntoView({ block: 'nearest' });
      };
      if (event.key === 'ArrowDown') {
        event.preventDefault();
        goTo(activeIndex + 1);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        goTo(activeIndex - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        goTo(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        goTo(opts.length - 1);
      } else if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        const active = opts[activeIndex];
        if (active) selectOption(active);
      } else if (event.key === 'Escape') {
        event.preventDefault();
        close();
        trigger.focus();
      } else if (event.key === 'Tab') {
        close();
      }
    });

    listbox.addEventListener('mousemove', (event) => {
      const li = (event.target as HTMLElement).closest<HTMLLIElement>('[role="option"]');
      if (li) setActive(li);
    });
    listbox.addEventListener('click', (event) => {
      const li = (event.target as HTMLElement).closest<HTMLLIElement>('[role="option"]');
      if (li) selectOption(li);
    });

    return {
      onChange(fn: (value: string, label: string) => void) {
        onChange = fn;
      },
      setItems(items: Option[]) {
        listbox.innerHTML = '';
        for (const item of items) {
          const li = document.createElement('li');
          li.setAttribute('role', 'option');
          li.dataset.value = item.value;
          li.textContent = item.label;
          if (item.value === '') li.setAttribute('aria-selected', 'true');
          listbox.appendChild(li);
        }
        label.textContent = items[0]?.label ?? '';
      },
      enable() {
        trigger.disabled = false;
        trigger.removeAttribute('aria-disabled');
      },
      disable() {
        close();
        trigger.disabled = true;
        trigger.setAttribute('aria-disabled', 'true');
      },
    };
  }

  function initFinder(root: HTMLElement) {
    const herstellerBox = setupCombobox(root.querySelector('[data-combobox][data-role="hersteller"]')!);
    const modellBox = setupCombobox(root.querySelector('[data-combobox][data-role="modell"]')!);
    const fahrzeugBox = setupCombobox(root.querySelector('[data-combobox][data-role="fahrzeug"]')!);
    const fallback = root.querySelector<HTMLElement>('[data-fallback]');
    const status = root.querySelector<HTMLElement>('[data-status]');

    function setStatus(text: string) {
      if (status) status.textContent = text;
    }

    function showUnavailable() {
      setStatus('Die Fahrzeugsuche ist gerade nicht erreichbar. Bitte kontaktieren Sie uns direkt mit Ihrem Fahrzeug.');
      if (fallback) fallback.style.display = 'inline-flex';
    }

    herstellerBox.onChange(async (herstellerId) => {
      modellBox.setItems([{ value: '', label: 'Modell' }]);
      modellBox.disable();
      fahrzeugBox.setItems([{ value: '', label: 'Fahrzeug' }]);
      fahrzeugBox.disable();
      if (!herstellerId) return;

      setStatus('Lade Modelle …');
      try {
        const res = await fetch(`/list_modelle_auswahl?hersteller=${encodeURIComponent(herstellerId)}`);
        if (!res.ok) throw new Error(String(res.status));
        const items = parseOptionsHtml(await res.text());
        modellBox.setItems(items.length ? items : [{ value: '', label: 'Modell' }]);
        modellBox.enable();
        setStatus('');
      } catch {
        modellBox.setItems([{ value: '', label: 'Modell' }]);
        modellBox.disable();
        showUnavailable();
      }
    });

    modellBox.onChange(async (modellId) => {
      fahrzeugBox.setItems([{ value: '', label: 'Fahrzeug' }]);
      fahrzeugBox.disable();
      if (!modellId) return;

      setStatus('Lade Fahrzeuge …');
      try {
        const res = await fetch(`/list_fahrzeuge_auswahl?modell=${encodeURIComponent(modellId)}`);
        if (!res.ok) throw new Error(String(res.status));
        const items = parseOptionsHtml(await res.text());
        fahrzeugBox.setItems(items.length ? items : [{ value: '', label: 'Fahrzeug' }]);
        fahrzeugBox.enable();
        setStatus('');
      } catch {
        fahrzeugBox.setItems([{ value: '', label: 'Fahrzeug' }]);
        fahrzeugBox.disable();
        showUnavailable();
      }
    });

    fahrzeugBox.onChange((url) => {
      if (url && url.startsWith('/')) {
        window.location.href = url;
      }
    });
  }

  document.querySelectorAll<HTMLElement>('[data-vehicle-finder]').forEach(initFinder);

  document.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('[data-combobox]')) return;
    closeAllListboxes();
  });
</script>
