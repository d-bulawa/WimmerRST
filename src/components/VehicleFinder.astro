---
import { manufacturers } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
const sortedManufacturers = [...manufacturers].sort((a, b) => a.name.localeCompare(b.name, 'de'));
---

<div class="rounded-2xl border border-[color:var(--color-line)] bg-[color:var(--color-surface)] p-5 sm:p-6" data-vehicle-finder>
  <div class="grid gap-3 sm:grid-cols-[1fr_1fr_1fr_auto]">
    <select id="vf-hersteller" class="rounded-lg border border-[color:var(--color-line)] bg-[color:var(--color-ink)] px-3 py-2.5 text-sm text-white">
      <option value="">Hersteller</option>
      {sortedManufacturers.map((m) => <option value={m.id}>{m.name}</option>)}
    </select>
    <select id="vf-modell" class="rounded-lg border border-[color:var(--color-line)] bg-[color:var(--color-ink)] px-3 py-2.5 text-sm text-white/50" disabled>
      <option>Modell</option>
    </select>
    <select id="vf-fahrzeug" class="rounded-lg border border-[color:var(--color-line)] bg-[color:var(--color-ink)] px-3 py-2.5 text-sm text-white/50" disabled>
      <option>Fahrzeug</option>
    </select>
    <a id="vf-fallback" href={withBase('/kontakt')} class="btn-secondary justify-center whitespace-nowrap" style="display: none;">Fahrzeug per Kontakt anfragen</a>
  </div>
  <p id="vf-status" class="mt-3 text-xs text-white/40" role="status"></p>
  {!compact && (
    <p class="mt-3 text-xs text-white/35">
      Wählen Sie Hersteller, Modell und Fahrzeug, um passende Chiptuning- und Tuning-Optionen für Ihr Fahrzeug zu finden.
    </p>
  )}
</div>

<script>
  const herstellerEl = document.getElementById('vf-hersteller') as HTMLSelectElement | null;
  const modellEl = document.getElementById('vf-modell') as HTMLSelectElement | null;
  const fahrzeugEl = document.getElementById('vf-fahrzeug') as HTMLSelectElement | null;
  const statusEl = document.getElementById('vf-status');
  const fallbackEl = document.getElementById('vf-fallback');

  function resetSelect(el: HTMLSelectElement | null, label: string) {
    if (!el) return;
    el.innerHTML = `<option>${label}</option>`;
    el.disabled = true;
    el.classList.add('text-white/50');
  }

  function showUnavailable() {
    if (statusEl) {
      statusEl.textContent =
        'Die Fahrzeugsuche ist gerade nicht erreichbar. Bitte kontaktieren Sie uns direkt mit Ihrem Fahrzeug.';
    }
    if (fallbackEl) (fallbackEl as HTMLElement).style.display = 'inline-flex';
  }

  herstellerEl?.addEventListener('change', async () => {
    const herstellerId = herstellerEl.value;
    resetSelect(fahrzeugEl, 'Fahrzeug');
    if (!herstellerId) {
      resetSelect(modellEl, 'Modell');
      return;
    }
    if (statusEl) statusEl.textContent = 'Lade Modelle …';
    try {
      const res = await fetch(`/list_modelle_auswahl?hersteller=${encodeURIComponent(herstellerId)}`);
      if (!res.ok) throw new Error(String(res.status));
      const html = await res.text();
      if (modellEl) {
        modellEl.innerHTML = html;
        modellEl.disabled = false;
        modellEl.classList.remove('text-white/50');
      }
      if (statusEl) statusEl.textContent = '';
    } catch {
      resetSelect(modellEl, 'Modell');
      showUnavailable();
    }
  });

  modellEl?.addEventListener('change', async () => {
    const modellId = modellEl.value;
    if (statusEl) statusEl.textContent = 'Lade Fahrzeuge …';
    try {
      const res = await fetch(`/list_fahrzeuge_auswahl?modell=${encodeURIComponent(modellId)}`);
      if (!res.ok) throw new Error(String(res.status));
      const html = await res.text();
      if (fahrzeugEl) {
        fahrzeugEl.innerHTML = html;
        fahrzeugEl.disabled = false;
        fahrzeugEl.classList.remove('text-white/50');
      }
      if (statusEl) statusEl.textContent = '';
    } catch {
      resetSelect(fahrzeugEl, 'Fahrzeug');
      showUnavailable();
    }
  });

  fahrzeugEl?.addEventListener('change', () => {
    const url = fahrzeugEl.value;
    if (url && url.startsWith('/')) {
      window.location.href = url;
    }
  });
</script>
