# Kopieren nach .env (wird von .gitignore ausgeschlossen) und Werte des
# NetCap-Servers eintragen. Wird von src/lib/db.ts über process.env gelesen –
# node lädt .env nicht automatisch, siehe db/README.md für den systemd-Service
# (dort per EnvironmentFile= eingebunden) bzw. `node --env-file=.env ...`.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wimmer
DB_USER=wimmer_app
DB_PASSWORD=

# Port/Host des Astro-SSR-Prozesses (@astrojs/node, mode: standalone).
# Läuft NICHT direkt am Internet – davor steht Nginx als Reverse Proxy
# (siehe db/README.md).
HOST=127.0.0.1
PORT=4321
